{
  "name": "oauth",
  "version": "0.1.0",
  "private": true,
  "description": "超本格アカウント・認証システム",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/server.ts dev",
    "build": "next build",
    "start": "node --import tsx scripts/server.ts start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/test/unit",
    "test:security": "vitest run src/test/security",
    "test:integration": "vitest run src/test/integration",
    "test:e2e": "vitest run src/test/e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "oidc:keygen": "tsx scripts/oidc-keygen.ts",
    "oidc:client": "tsx scripts/oidc-client.ts",
    "oidc:load": "tsx scripts/oidc-load-test.ts",
    "db:verify-migrations": "tsx scripts/verify-migrations.ts",
    "seed": "tsx scripts/seed.ts",
    "secrets:gen": "tsx scripts/generate-secrets.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "^15.5.27",
    "oidc-provider": "^9.12.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "eslint-plugin-security": "^4.2.0",
    "openid-client": "^6.8.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
