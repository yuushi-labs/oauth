# ---------------------------------------------------------------------------
# 実値は commit しない（仕様52章）。開発用は `pnpm secrets:gen` が .env に生成する。
# 本番は Secret Manager 等から注入する。
# ---------------------------------------------------------------------------

# DB（必須）
DATABASE_URL=postgresql://app:dev_password@localhost:5432/app
# DB 接続の TLS モード（任意・既定 disable）。DB は localhost のみで待ち受ける前提。
# 自己署名証明書の DB へ TLS で繋ぐ場合は require、正規 CA で検証する場合は verify-full。
# DATABASE_URL に sslmode を書いた場合はそちらが優先される。
DATABASE_SSL_MODE=disable

# Redis（任意。未設定ならレート制限は PostgreSQL にフォールバック: D-05）
REDIS_URL=
RATE_LIMIT_SECRET=          # optional; defaults to TOKEN_PEPPER, 32 characters or more
ALLOWED_ORIGINS=           # comma-separated CORS allowlist; defaults to NEXT_PUBLIC_APP_URL
CSRF_TRUSTED_ORIGINS=      # independent CSRF allowlist; defaults to NEXT_PUBLIC_APP_URL
ALLOWED_HOSTS=             # comma-separated hosts accepted for HTTPS redirects
TRUSTED_PROXY_HOPS=0       # 0 trusts no forwarding headers
TRUSTED_PROXY_HEADER=      # e.g. cf-connecting-ip; only set for a trusted edge proxy

# OIDC Provider（任意。未設定ならOIDC endpointsは起動しない）
# `pnpm oidc:keygen` で署名鍵とDB暗号鍵を生成し、secret managerへ保存する。
# OIDC_ISSUER=http://localhost:3000
# OIDC_JWKS_JSON={"keys":[...]}   # 引用符なしで書くこと（JSON に空白を含めない）
# OIDC_ADAPTER_ENCRYPTION_KEY=<base64-32-byte-key>
# 管理画面で1ユーザーが登録できる client の上限（既定 5）
# OIDC_MAX_CLIENTS_PER_USER=5

# 暗号関連（必須・32バイト以上）
SESSION_PEPPER=
TOKEN_PEPPER=
IP_HASH_PEPPER=
CSRF_SECRET=
# AES-256-GCM 用キー（Base64 32バイト）
TOTP_ENCRYPTION_KEY=

# アプリ（必須）
NEXT_PUBLIC_APP_NAME=oauth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 漏洩パスワード検査（任意・Phase 1-A で使用）
HIBP_TIMEOUT_MS=1500
# HIBP 障害時に登録を許可するか（D-17: true=fail-open）
BREACH_CHECK_FAIL_OPEN=true

# Argon2id パラメータ（Phase 1-A で使用）
# m: メモリコスト（KiB）、t: 時間コスト、p: 並列度
ARGON2_M=65536
ARGON2_T=3
ARGON2_P=4

# メール（Phase 1-B で使用）
RESEND_API_KEY=
EMAIL_FROM=

# OAuth（Phase 4 で使用。Apple は除外: C-01）
# ★ 取得手順は interop/README.md を参照（3 provider それぞれのコンソールでの手続き）
# ★ redirect URI は NEXT_PUBLIC_APP_URL と origin を一致させて登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot 対策（任意・Phase 9 で接続）
# Turnstile を使う場合は site key と secret の**両方**を注入する。
# 片方だけだと本番起動時に fail fast する（ウィジェットが出ないのに検証済み扱いになる事故を防ぐ・BUG-22）。
# - site key はブラウザがウィジェットを描画するために使う（公開情報）。
# - secret はサーバが siteverify を叩くために使う（秘匿）。
# どちらも未設定なら CAPTCHA は無効のまま（ソフトリミット超過時は 500 で fail-closed）。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Turnstile の検証タイムアウト（ミリ秒）
CAPTCHA_TIMEOUT_MS=3000

# バックアップ暗号鍵（Phase 9 / §53）。Base64 32 バイト。
# 未設定だと `pnpm backup` は失敗する（平文でバックアップしない）。
# 生成: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# ローカル DB 用（compose.yaml が参照）
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=dev_password
