# ---------------------------------------------------------------------------
# 実値は commit しない（仕様52章）。開発用は `pnpm secrets:gen` が .env に生成する。
# 本番は Secret Manager 等から注入する。
# ---------------------------------------------------------------------------

# DB（必須）
DATABASE_URL=postgresql://app:dev_password@localhost:5432/app

# Redis（任意。未設定ならレート制限は PostgreSQL にフォールバック: D-05）
REDIS_URL=

# 暗号関連（必須・32バイト以上）
SESSION_PEPPER=
TOKEN_PEPPER=
IP_HASH_PEPPER=
CSRF_SECRET=
# AES-256-GCM 用キー（Base64 32バイト）
TOTP_ENCRYPTION_KEY=

# アプリ（必須）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 漏洩パスワード検査（任意・Phase 1-A で使用）
HIBP_TIMEOUT_MS=1500
# HIBP 障害時に登録を許可するか（D-17: true=fail-open）
BREACH_CHECK_FAIL_OPEN=true

# メール（Phase 1-B で使用）
RESEND_API_KEY=
EMAIL_FROM=

# OAuth（Phase 4 で使用。Apple は除外: C-01）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot 対策（任意・Phase 9 で接続）
TURNSTILE_SECRET_KEY=

# ローカル DB 用（compose.yaml が参照）
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=dev_password